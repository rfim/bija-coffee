{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -u -m http.server 8099",
      "startServerReadyPattern": "Serving HTTP",
      "startServerReadyTimeout": 20000,
      "url": [
        "http://localhost:8099/index.html?view=site",
        "http://localhost:8099/shop.html",
        "http://localhost:8099/product.html?id=lintong",
        "http://localhost:8099/app.html?view=app"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median-run"
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
